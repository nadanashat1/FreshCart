NEXTAUTH_SECRET=replace-with-a-random-string
NEXTAUTH_URL=http://localhost:3000

# Social sign-in (optional): buttons stay in "not available" notice mode
# until both values for a provider are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
# Dedicated secret for deriving Route API account passwords for social users;
# set this to its own random string so rotating NEXTAUTH_SECRET does not
# orphan social-provisioned accounts. Falls back to NEXTAUTH_SECRET if unset.
SOCIAL_PROVISION_SECRET=
